{
  "name": "Book 1 proposal \u2014 UNAPPLIED",
  "kind": "zone",
  "phase": "http_request_cache_settings",
  "rules": [
    {
      "ref": "rights_book_cache_bypass",
      "description": "Revalidate unversioned Book 1 resources",
      "expression": "(http.host eq \"dhilipsiva.dev\" and starts_with(http.request.uri.path, \"/rights-nobody-has-to-earn/\"))",
      "action": "set_cache_settings",
      "enabled": false,
      "action_parameters": {
        "cache": false,
        "browser_ttl": {
          "mode": "respect_origin"
        }
      }
    }
  ]
}
